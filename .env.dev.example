# AgentOTel — DEV environment template
# Copy to `.env` on dev machine (47.110.255.35), fill real values, DO NOT commit.
# Usage: `docker compose up -d --build`

# ---- MySQL (dev uses external MySQL on the dev host itself) ----
MYSQL_HOST=47.110.255.35
MYSQL_PORT=3306
MYSQL_USER=agentotel
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DB=agentotel_meta

# ---- ClickHouse (dev may use local container `clickhouse` service or external) ----
CLICKHOUSE_DB=agent_observability
CLICKHOUSE_URL=http://clickhouse:8123/?database=agent_observability

# ---- Aliyun SMS ----
SMS_PROVIDER=console
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_LOGIN_TEMPLATE_CODE=
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=
ALIYUN_SMS_FORGET_PASSWORD_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/
ALIYUN_SMS_REGION_ID=cn-hangzhou

# ---- OTel Collector ----
AGENTOTEL_API_KEY=dev-local-key
