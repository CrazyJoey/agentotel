[Unit]
Description=AgentOTel OpenTelemetry Collector
Documentation=https://github.com/CrazyJoey/agentotel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=admin
Group=admin
# %h expands to admin's home. Works on:
#   dev  = /home/admin/workspace/agentotel  (symlink /home/admin/agentotel -> workspace/agentotel, or use dev-only unit override)
#   prod = /home/admin/agentotel
# See docs/OPERATIONS.md for env layout.
WorkingDirectory=%h/agentotel
EnvironmentFile=-%h/agentotel/.env
ExecStart=%h/agentotel/bin/agentotel-collector --config %h/agentotel/opentelemetry-collector/config/agentotel-local.yaml
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65536

Environment=GOMEMLIMIT=512MiB
Environment=GOPROXY=https://goproxy.cn,direct

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=%h/agentotel

[Install]
WantedBy=multi-user.target
