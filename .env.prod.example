# AgentOTel — PROD environment template
# Copy to `~/agentotel/.env` on prod (47.237.100.232), fill real values, DO NOT commit.
# Real secrets live in `docs/SECRETS.md` (git-ignored) or a secret manager.
# Usage: `bash deploy/deploy-prod.sh`

# ---- Backend listen ----
HOST=127.0.0.1
PORT=8091

# ---- MySQL (prod uses local MySQL on prod host) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=agentotel
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DB=agentotel_meta

# ---- ClickHouse (EXTERNAL — Simon's instance, do NOT deploy local) ----
CLICKHOUSE_DB=agent_observability
CLICKHOUSE_URL=http://121.43.27.45:8123/?database=agent_observability

PROJECT_ID=default
ENVIRONMENT=prod

# ---- Aliyun SMS ----
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=CHANGE_ME
ALIYUN_SMS_ACCESS_KEY_SECRET=CHANGE_ME
ALIYUN_SMS_SIGN_NAME=广州浮光智能科技
ALIYUN_SMS_LOGIN_TEMPLATE_CODE=SMS_498805405
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=
ALIYUN_SMS_FORGET_PASSWORD_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/
ALIYUN_SMS_REGION_ID=cn-hangzhou

# ---- OTel Collector (systemd unit reads this) ----
AGENTOTEL_API_KEY=CHANGE_ME
